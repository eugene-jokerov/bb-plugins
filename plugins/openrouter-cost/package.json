{
  "name": "bb-plugin-openrouter-cost",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.49",
    "bbPluginSdk": ">=0.6.132"
  },
  "bb": {
    "name": "OpenRouter Cost",
